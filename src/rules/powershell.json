{
  "languageId": "powershell",
  "rules": [
    {
      "id": "ps-function",
      "kind": "declaration",
      "pattern": "\\bfunction\\s+([A-Za-z0-9_-]+)",
      "captureGroups": { "kind": "function", "name": 1 }
    },
    {
      "id": "ps-import-module",
      "kind": "import",
      "pattern": "\\b(?:Import-Module|\\.\\s+\\.\\\\)\\s*['\"]?([^'\"\\s]+)['\"]?",
      "captureGroups": { "module": 1 }
    },
    {
      "id": "ps-rest",
      "kind": "external",
      "pattern": "\\b(?:Invoke-RestMethod|Invoke-WebRequest)\\s+-Uri\\s+['\"]?([^'\"\\s]+)['\"]?",
      "captureGroups": { "name": 1, "kind": "HTTP" }
    }
  ]
}
