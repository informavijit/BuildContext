{
  "languageId": "perl",
  "rules": [
    {
      "id": "perl-package",
      "kind": "declaration",
      "pattern": "^\\s*package\\s+([A-Za-z0-9_:]+);",
      "captureGroups": { "kind": "package", "name": 1 }
    },
    {
      "id": "perl-use",
      "kind": "import",
      "pattern": "^\\s*(?:use|require)\\s+([A-Za-z0-9_:]+)",
      "captureGroups": { "module": 1 }
    },
    {
      "id": "perl-sub",
      "kind": "declaration",
      "pattern": "^\\s*sub\\s+([A-Za-z0-9_]+)",
      "captureGroups": { "kind": "subroutine", "name": 1 }
    }
  ]
}
